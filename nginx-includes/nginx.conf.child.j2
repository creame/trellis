{% extends 'roles/nginx/templates/nginx.conf.j2' %}

  {% block http_begin %}
  {{ super() }}

  {% if cloudflare_enabled | default(false) -%}
  # Trust Cloudflare edge proxies and recover the real client IP.
  real_ip_header {{ cloudflare_real_ip_header | default('CF-Connecting-IP') }};
  real_ip_recursive on;
  {% for proxy in cloudflare_trusted_proxies | default([]) -%}
  set_real_ip_from {{ proxy }};
  {% endfor %}
  {% endif %}
  {% endblock %}